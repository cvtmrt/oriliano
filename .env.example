# ---------------------------------------------------------------------------
# Çetiner Hukuk ve Danışmanlık — ortam değişkenleri
#
# Yerelde: bu dosyayı .env olarak kopyalayın.
# Railway'de: Variables sekmesine tek tek girin.
# ---------------------------------------------------------------------------

# Veritabanı — Railway'de Postgres eklentisi eklendiğinde otomatik gelir.
# Railway içinden referansla bağlamak en temizi: ${{ Postgres.DATABASE_URL }}
DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/cetiner?schema=public"

# ---------------------------------------------------------------------------
# Yönetici girişi
# ---------------------------------------------------------------------------
# Şifre karmasını üretmek için:  npm run hash -- "sifreniz"
# Şifrenin kendisi hiçbir yere yazılmaz, yalnızca karma saklanır.
ADMIN_EMAIL="ornek@cetinerlegal.com"
ADMIN_PASSWORD_HASH="$2a$12$buraya_bcrypt_karmasi_gelecek"

# Oturum çerezini imzalar. En az 32 karakter rastgele değer:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="buraya_32_karakterden_uzun_rastgele_bir_deger"

# ---------------------------------------------------------------------------
# Otomatik çeviri (Türkçe → İngilizce)
# ---------------------------------------------------------------------------
# İKİ SAĞLAYICIDAN BİRİ yeterli. Hiçbiri tanımlı değilse panel çalışmaya devam
# eder; İngilizce alanlar elle doldurulur, boş kalırsa site Türkçe gösterir.
#
# 1) Google Gemini — ÜCRETSİZ KATMANI VAR, bu site için fazlasıyla yeterli.
#    Anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Model adı zamanla değişebilir; boş bırakılırsa gemini-2.5-flash denenir,
# bulunamazsa 2.0-flash ve 1.5-flash'a düşer.
GEMINI_MODEL=""

# 2) Anthropic — kullandıkça öde. Anahtar: https://console.anthropic.com
ANTHROPIC_API_KEY=""

# İkisi de tanımlıysa Gemini kullanılır. Zorlamak için: "gemini" | "anthropic"
TRANSLATION_PROVIDER=""

# ---------------------------------------------------------------------------
# Panel kapısı
# ---------------------------------------------------------------------------
# Tanımlıysa /admin adresine anahtarsız gelen istek 404 alır — giriş formu bile
# görünmez. Bir kez /admin?k=<anahtar> ile açılır, sonrası çerezle hatırlanır.
# En az 12 karakter olmalı; boş bırakılırsa kapı devre dışı kalır.
ADMIN_GATE_KEY=""

# ---------------------------------------------------------------------------
# Görsel depolama (Railway Volume)
# ---------------------------------------------------------------------------
# Railway'de servise bir Volume ekleyip mount path'ini /data yapın ve burayı
# /data/uploads olarak ayarlayın. Yerelde varsayılan ./.uploads yeterlidir.
UPLOAD_DIR="./.uploads"
UPLOAD_MAX_BYTES="8388608"
UPLOAD_MAX_DIMENSION="2400"

# ---------------------------------------------------------------------------
# Site adresi
# ---------------------------------------------------------------------------
# Kanonik adres, hreflang, sitemap ve paylaşım görselleri buna göre üretilir.
# Panelden de değiştirilebilir (Genel Ayarlar → Alan adı).
SITE_URL="https://cetinerlegal.com"

# Ön izleme/staging ortamında arama motorlarını engellemek için "true" yapın.
DISALLOW_INDEXING="false"

# ---------------------------------------------------------------------------
# İlk kurulum
# ---------------------------------------------------------------------------
# "true" ise sunucu ilk açılışta örnek içeriği yükler. Railway gibi
# veritabanının yalnızca özel ağdan erişilebildiği yerlerde dışarıdan seed
# atılamadığı için gerekiyor. Yükledikten sonra "false" yapın.
# Aynı işi panelden de yapabilirsiniz: Araçlar → Örnek verileri yükle.
SEED_ON_BOOT="false"
